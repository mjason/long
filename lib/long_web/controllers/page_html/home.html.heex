<div class="min-h-screen bg-zinc-100 text-zinc-900">
  <div class="max-w-5xl mx-auto px-6 py-16">
    <header class="mb-12">
      <h1 class="text-3xl font-semibold tracking-tight">Long</h1>
      <p class="mt-2 text-zinc-500">
        Phoenix / Ash port of the GenericAgent — chat, memory, skills, and bots in one runtime.
      </p>
    </header>

    <section class="mb-12">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-500 mb-3">Workspaces</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <.nav_card
          navigate={~p"/chat"}
          icon="hero-chat-bubble-left-right"
          title="Chat"
          desc="Talk to the agent. ReAct loop, tools, memory, scheduled tasks."
          accent="primary"
        />
        <.nav_card
          navigate={~p"/manage"}
          icon="hero-cog-6-tooth"
          title="Manage"
          desc="LLMs, memories, skills, search providers, scheduled tasks."
          accent="info"
        />
        <.nav_card
          navigate={~p"/wechat"}
          icon="hero-device-phone-mobile"
          title="WeChat bot"
          desc="QR login flow + credential rotation."
          accent="success"
        />
      </div>
    </section>

    <section>
      <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-500 mb-3">
        Operator dashboards
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <.dev_card href="/errors" icon="hero-exclamation-triangle" title="Errors" desc="ErrorTracker dashboard" />
        <.dev_card href="/oban" icon="hero-queue-list" title="Jobs" desc="Oban Web" />
        <.dev_card href="/dashboard" icon="hero-chart-bar" title="Metrics" desc="LiveDashboard" />
        <.dev_card :if={@dev_routes?} href="/admin" icon="hero-shield-check" title="Admin" desc="Ash Admin (dev only)" />
      </div>
    </section>
  </div>
</div>
